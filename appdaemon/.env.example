# Copy to .env and fill in real values. Never commit .env itself.
# In production, Kubernetes injects these via envFrom: secretRef: name: appdaemon-secret
# ha_url and immich_url stay in secrets.yaml (intercluster endpoints)
TOKEN=your-home-assistant-long-lived-access-token
OPENAPI_TOKEN=sk-proj-your-key
IMMICH_API_KEY=your-immich-api-key
