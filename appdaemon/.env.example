# Copy to .env and fill in real values. Never commit .env itself.
# In production, Kubernetes injects these via envFrom: secretRef: name: appdaemon-secret
# ha_url and immich_url stay in secrets.yaml (intercluster endpoints)
TOKEN=your-home-assistant-long-lived-access-token
OPENAPI_TOKEN=sk-proj-your-key
IMMICH_API_KEY=your-immich-api-key
SCHOOL_LUNCH=https://www.schoolnutritionandfitness.com/index.php?sid=your-district-site-id&page=menus
# school_schedule_app — Finalsite calendar URL + PowerSchool guardian portal
MIDDLE_ALL_EVENTS=https://www.your-school.org/page/view-all-events
POWER_SCHOOL=https://powerschool.your-district.org
MIDDLE_USER=your-powerschool-guardian-username
MIDDLE_PASSWORD=your-powerschool-guardian-password
