    {
      "entity_id": "script.brighten_all_lights",
      "script_id": "brighten_all_lights",
      "friendly_name": "Brighten All Lights",
      "score": 100,
      "match_in_name": false,
      "match_in_config": true,
      "match_in_references": false,
      "config": {
        "alias": "Brighten All Lights",
        "description": "Saves state + brightens all configured lights to 100% and target Kelvin (default 2750K), with a 2 second delay between each to avoid overwhelming the network.\n",
        "fields": {
          "kelvin": {
            "name": "Target Kelvin",
            "description": "Color temperature to set (Kelvin). Defaults to 2750K.",
            "required": false,
            "default": 2750,
            "selector": {
              "number": {
                "min": 1500,
                "max": 9000,
                "step": 50,
                "mode": "slider"
              }
            }
          },
          "snapshot_prefix": {
            "name": "Snapshot Prefix",
            "description": "Prefix used for snapshot scene_id. Defaults to \"light_state_snapshot\".",
            "required": false,
            "default": "light_state_snapshot",
            "selector": {
              "text": {}
            }
          }
        },
        "sequence": [
          {
            "variables": {
              "target_kelvin": "{{ kelvin | default(2750) | int }}",
              "prefix": "{{ snapshot_prefix | default('light_state_snapshot') }}",
              "lights": [
                "light.upstairs_foyer_lights",
                "light.upstairs_primary_hall_lights",
                "light.upstairs_primary_bath_lights",
                "light.upstairs_primary_bed_lights",
                "light.upstairs_primary_nook_lights",
                "light.upstairs_primary_cloffice_lights",
                "light.downstairs_entrance_lights",
                "light.downstairs_mudroom_lights",
                "light.downstairs_kitchen_lights",
                "light.downstairs_livingroom_lights",
                "light.basement_concessions_lights",
                "light.basement_hall_lights",
                "light.basement_movie_room_lights",
                "light.basement_rumpus_room_lights"
              ]
            }
          },
          {
            "repeat": {
              "for_each": "{{ lights }}",
              "sequence": [
                {
                  "action": "script.save_original_state_and_brighten_single_light",
                  "data": {
                    "entity_id": "{{ repeat.item }}",
                    "kelvin": "{{ target_kelvin }}",
                    "snapshot_prefix": "{{ prefix }}"
                  }
                },
                {
                  "delay": {
                    "seconds": 2
                  }
                }
              ]
            }
          }
        ],
        "mode": "single"
      }
    },
